# Django and database
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Omit this for local SQLite. Docker Compose overrides it with PostgreSQL.
# DJANGO_DATABASE_URL=postgresql://vulcan:vulcan@localhost:5432/vulcan
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Workers and object storage (optional for the lightweight local workflow)
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
AWS_ACCESS_KEY_ID=vulcan
AWS_SECRET_ACCESS_KEY=vulcan-local-secret
AWS_REGION=ap-south-1
AWS_S3_BUCKET=vulcan-factory-data
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
UPLOAD_URL_TTL_SECONDS=900
MAX_SYNC_UPLOAD_BYTES=10485760
