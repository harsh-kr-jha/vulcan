# Django and database
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
VULCAN_VARIANT=mushroom
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# PostgreSQL is required outside isolated tests. Docker Compose overrides this.
DJANGO_DATABASE_URL=postgresql://vulcan:vulcan@localhost:5432/vulcan
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
DJANGO_NUM_PROXIES=0
DJANGO_TRUST_PROXY_HEADERS=false
DJANGO_USE_X_FORWARDED_HOST=false
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
SESSION_COOKIE_AGE_SECONDS=28800
LOGIN_IP_RATE=10/15m
LOGIN_ACCOUNT_RATE=5/15m
DJANGO_LOG_LEVEL=INFO
# Keep this stable across deploys. Changing it makes stored stream API keys unreadable.
DATA_STREAM_CREDENTIAL_KEY=replace-with-a-separate-long-random-secret
DATA_STREAM_POLL_SECONDS=5
DATA_STREAM_RETENTION_DAYS=30
# Optional local showcase login; set both, with a unique 15+ character password.
# MUSHROOM_DEMO_EMAIL=operator@example.com
# MUSHROOM_DEMO_PASSWORD=

# Workers and object storage (optional for the lightweight local workflow)
REDIS_URL=redis://redis:6379/0
DJANGO_CACHE_URL=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false
AWS_ACCESS_KEY_ID=vulcan
AWS_SECRET_ACCESS_KEY=vulcan-local-secret
AWS_REGION=ap-south-1
AWS_S3_BUCKET=vulcan-factory-data
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
UPLOAD_URL_TTL_SECONDS=900
MAX_SYNC_UPLOAD_BYTES=10485760

# Externally trained prediction models. Admin ZIP uploads are capped at 100 MiB.
ML_MODEL_SOURCE=local
ML_MODEL_DIR=models
ML_MODEL_UPLOAD_MAX_BYTES=104857600
