{
  "title": "Tamaso Client Configuration",
  "description": "Per-customer configuration on a client branch at config/config.json.",
  "type": "object",
  "required": [
    "clientId",
    "displayName",
    "factoryCode",
    "configVersion"
  ],
  "properties": {
    "clientId": {
      "type": "string",
      "pattern": "^[A-Z0-9]{3,12}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "factoryCode": {
      "type": "string",
      "minLength": 1
    },
    "configVersion": {
      "type": "string",
      "pattern": "^[A-Z0-9]{3,12}-C[0-9]{2}$"
    },
    "deploymentId": {
      "type": "string"
    },
    "environmentOverrides": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}