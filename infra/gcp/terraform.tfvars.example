project_id               = "<project-id>"
region                   = "asia-south1"
network                  = "projects/<project-id>/global/networks/<network>"
subnet                   = "projects/<project-id>/regions/asia-south1/subnetworks/<subnet>"
cloud_sql_instance_name  = "<shared-cloud-sql-instance>"
frontend_image           = "asia-south1-docker.pkg.dev/<project-id>/<repository>/frontend@sha256:<digest>"
backend_image            = "asia-south1-docker.pkg.dev/<project-id>/<repository>/backend@sha256:<digest>"

verticals = {
  mushroom = {
    domain         = "mushroom.example.com"
    database_name  = "vulcan_mushroom"
    bucket_name    = "<project-id>-mushroom-production"
    min_instances  = 0
    max_instances  = 5
    # retention_days = 30 # Enable only after the source-data policy is approved.

    extra_backend_env = {
      DJANGO_NUM_PROXIES          = "<verified-count>"
      DJANGO_TRUST_PROXY_HEADERS  = "true"
      DJANGO_USE_X_FORWARDED_HOST = "false"
    }

    runtime_secrets = {
      DJANGO_SECRET_KEY    = { secret = "mushroom-django-secret-key", version = "<pinned-version>" }
      DJANGO_DATABASE_URL  = { secret = "mushroom-runtime-database-url", version = "<pinned-version>" }
      REDIS_URL            = { secret = "mushroom-redis-broker-url", version = "<pinned-version>" }
      DJANGO_CACHE_URL     = { secret = "mushroom-redis-cache-url", version = "<pinned-version>" }
    }

    migration_secrets = {
      DJANGO_SECRET_KEY    = { secret = "mushroom-django-secret-key", version = "<pinned-version>" }
      DJANGO_DATABASE_URL  = { secret = "mushroom-migration-database-url", version = "<pinned-version>" }
      REDIS_URL            = { secret = "mushroom-redis-broker-url", version = "<pinned-version>" }
      DJANGO_CACHE_URL     = { secret = "mushroom-redis-cache-url", version = "<pinned-version>" }
    }
  }

  automotive = {
    domain         = "auto.example.com"
    database_name  = "vulcan_automotive"
    bucket_name    = "<project-id>-automotive-production"
    min_instances  = 0
    max_instances  = 5
    # retention_days = 30 # Enable only after the source-data policy is approved.

    extra_backend_env = {
      DJANGO_NUM_PROXIES          = "<verified-count>"
      DJANGO_TRUST_PROXY_HEADERS  = "true"
      DJANGO_USE_X_FORWARDED_HOST = "false"
    }

    runtime_secrets = {
      DJANGO_SECRET_KEY    = { secret = "automotive-django-secret-key", version = "<pinned-version>" }
      DJANGO_DATABASE_URL  = { secret = "automotive-runtime-database-url", version = "<pinned-version>" }
      REDIS_URL            = { secret = "automotive-redis-broker-url", version = "<pinned-version>" }
      DJANGO_CACHE_URL     = { secret = "automotive-redis-cache-url", version = "<pinned-version>" }
    }

    migration_secrets = {
      DJANGO_SECRET_KEY    = { secret = "automotive-django-secret-key", version = "<pinned-version>" }
      DJANGO_DATABASE_URL  = { secret = "automotive-migration-database-url", version = "<pinned-version>" }
      REDIS_URL            = { secret = "automotive-redis-broker-url", version = "<pinned-version>" }
      DJANGO_CACHE_URL     = { secret = "automotive-redis-cache-url", version = "<pinned-version>" }
    }
  }
}
